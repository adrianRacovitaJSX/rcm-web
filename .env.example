# Google Analytics 4 (ID de medición, empieza por G-). Sin él no se carga GA ni sale el banner de cookies.
NEXT_PUBLIC_GA_ID=
# Google Search Console: valor "content" de la etiqueta meta de verificación (método "Etiqueta HTML").
NEXT_PUBLIC_GSC_VERIFICATION=
# URL de la app de informes (verificación). Por defecto https://informes.revisioncochemadrid.es
NEXT_PUBLIC_INFORMES_URL=
# Resend: emails del formulario de reserva (aviso a contacto@ y confirmación al cliente)
RESEND_API_KEY=
EMAIL_FROM="Revisión Coche Madrid <no-reply@revisioncochemadrid.es>"
# Adónde llegan las reservas (por defecto contacto@revisioncochemadrid.es)
BOOKING_NOTIFY_TO=
# Copia oculta de cada reserva, separadas por comas (por defecto epicarscoches@gmail.com,marteloemerson@gmail.com)
BOOKING_NOTIFY_BCC=
